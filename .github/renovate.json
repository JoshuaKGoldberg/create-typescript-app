{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"automerge": true,
	"customManagers": [
		{
			"customType": "regex",
			"datasourceTemplate": "github-tags",
			"description": "Default GitHub Actions versions that blocks pass to resolveUses().",
			"managerFilePatterns": ["/^src/blocks/.+\\.ts$/"],
			"matchStrings": [
				"resolveUses\\(\\s*\"(?<depName>[^\"]+)\",\\s*\"(?<currentValue>[^\"]+)\",\\s*[\\w.]+,\\s*\"(?<currentDigest>[a-f\\d]{40})\""
			],
			"versioningTemplate": "github-actions"
		}
	],
	"extends": [
		":preserveSemverRanges",
		"config:best-practices",
		"replacements:all"
	],
	"ignoreDeps": ["all-contributors-cli", "codecov/codecov-action"],
	"labels": ["dependencies"],
	"minimumReleaseAge": "7 days",
	"packageRules": [
		{
			"automerge": false,
			"matchFileNames": ["src/data/blockDependencies/package.json"]
		},
		{
			"description": "The Engines Check job's Node.js version is the minimum from engines.node.",
			"enabled": false,
			"matchDepNames": ["node"],
			"matchFileNames": [".github/workflows/ci.yaml"]
		},
		{
			"groupName": "Bingo",
			"matchSourceUrls": ["https://github.com/bingo-js/bingo"]
		}
	],
	"patch": { "enabled": false },
	"postUpdateOptions": ["pnpmDedupe"]
}
